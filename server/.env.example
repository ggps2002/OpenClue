# Copied to .env automatically on `npm install` if .env does not exist.
NODE_ENV=development
PORT=4000
# SQLite file relative to prisma/schema.prisma. For Postgres use a postgresql:// URL and change the provider.
DATABASE_URL="file:./dev.db"
# Required in production. Any long random string.
JWT_SECRET=change-me-in-production
# Local media storage directory (relative to the server package).
STORAGE_DIR=storage
# Largest accepted upload, in megabytes.
MAX_UPLOAD_MB=500

# AI (optional). Without keys, AI features run in offline mode with placeholder output.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# OpenAI speech-to-text model; must support segment timestamps (verbose_json).
STT_MODEL=whisper-1

# OpenAI text-to-speech model used for voiceovers.
TTS_MODEL=gpt-4o-mini-tts

# How many exports render at the same time (each runs one ffmpeg process).
RENDER_CONCURRENCY=1
